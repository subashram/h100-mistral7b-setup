# =============================================================================
# Mixed-Model Production Configuration
# Topology:
# - GPUs 0-1: Mistral 7B
# - GPUs 4-7: Mixtral 8x7B
# - GPUs 2-3: spare
# =============================================================================

# Shared model access
HF_TOKEN=
VLLM_IMAGE=vllm/vllm-openai:latest
TOKENIZER_MODE=hf
CONFIG_FORMAT=hf
LOAD_FORMAT=hf
TOOL_CALL_PARSER=mistral
CHAT_TEMPLATE=/vllm-workspace/examples/tool_chat_template_mistral_parallel.jinja

# Mistral 7B lane
MISTRAL_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
MISTRAL_MODEL_DTYPE=bfloat16
MISTRAL_GPU_MEMORY_UTILIZATION=0.90
MISTRAL_MAX_MODEL_LEN=8192
MISTRAL_MAX_NUM_BATCHED_TOKENS=16384
MISTRAL_MAX_NUM_SEQS=256

# Mixtral 8x7B lane
SMALL32_MODEL_ID=mistralai/Mistral-Small-3.2-24B-Instruct-2506
SMALL32_VISIBLE_DEVICES=4,5,6,7
SMALL32_TENSOR_PARALLEL_SIZE=4
SMALL32_MODEL_DTYPE=bfloat16
SMALL32_TOKENIZER_MODE=mistral
SMALL32_CONFIG_FORMAT=mistral
SMALL32_LOAD_FORMAT=mistral
SMALL32_TOOL_CALL_PARSER=mistral
SMALL32_GPU_MEMORY_UTILIZATION=0.92
SMALL32_MAX_MODEL_LEN=131072
SMALL32_MAX_NUM_BATCHED_TOKENS=16384
SMALL32_MAX_NUM_SEQS=128

# Spare capacity
SPARE_GPUS=2,3

# Gateway exposure
PUBLIC_GATEWAY_BIND_HOST=127.0.0.1
PUBLIC_GATEWAY_HTTP_PORT=8081
PUBLIC_GATEWAY_HTTPS_PORT=8443

# Persistent data
DATA_ROOT=/mnt/compass/mistral
MODEL_CACHE_ROOT=/mnt/compass/mistral/model-cache
VLLM_CACHE_ROOT=/mnt/compass/mistral/vllm-cache
PROMETHEUS_DATA_ROOT=/mnt/compass/mistral/prometheus
GRAFANA_DATA_ROOT=/mnt/compass/mistral/grafana
LOKI_DATA_ROOT=/mnt/compass/mistral/loki
LOG_ROOT=/mnt/compass/mistral/logs

# Benchmarking defaults
BENCHMARK_TOTAL_REQUESTS=400
BENCHMARK_CONCURRENCY=32
BENCHMARK_MAX_TOKENS=64

# API Authentication
API_KEYS=sk-prod-key-1,sk-prod-key-2

# TLS
TLS_CERT_PATH=./nginx/certs/server.crt
TLS_KEY_PATH=./nginx/certs/server.key

# Monitoring
GRAFANA_ADMIN_PASSWORD=changeme-in-production
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=oncall@yourcompany.com

# Logging
LOG_LEVEL=warning
ACCESS_LOG_PATH=/mnt/compass/mistral/logs/access.log
ERROR_LOG_PATH=/mnt/compass/mistral/logs/error.log

# Health Check
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=3

# Resource Limits
VLLM_CPU_LIMIT=10
VLLM_MEM_LIMIT=48g
VLLM_SHM_SIZE=8g
