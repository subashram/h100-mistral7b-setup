# =============================================================================
# Mistral 7B Production Configuration
# =============================================================================

# Model
MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3
MODEL_DTYPE=fp8
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_BATCHED_TOKENS=16384
MAX_NUM_SEQS=256

# Serving
VLLM_IMAGE=vllm/vllm-openai:latest
BASE_PORT=8000

# Benchmarking defaults
BENCHMARK_TOTAL_REQUESTS=400
BENCHMARK_CONCURRENCY=32
BENCHMARK_MAX_TOKENS=64

# API Authentication (comma-separated valid keys)
API_KEYS=sk-prod-key-1,sk-prod-key-2

# Rate Limiting
RATE_LIMIT_RPM=600        # requests per minute per API key
RATE_LIMIT_BURST=50       # burst allowance

# TLS (set paths to your certs)
TLS_CERT_PATH=./nginx/certs/server.crt
TLS_KEY_PATH=./nginx/certs/server.key

# Monitoring
GRAFANA_ADMIN_PASSWORD=changeme-in-production
ALERTMANAGER_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=oncall@yourcompany.com

# Logging
LOG_LEVEL=warning
ACCESS_LOG_PATH=/var/log/mistral/access.log
ERROR_LOG_PATH=/var/log/mistral/error.log

# Health Check
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_RETRIES=3

# Resource Limits
VLLM_CPU_LIMIT=10
VLLM_MEM_LIMIT=48g
VLLM_SHM_SIZE=8g
