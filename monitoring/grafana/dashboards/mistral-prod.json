{
  "dashboard": {
    "title": "Mistral 7B — Production Dashboard",
    "uid": "mistral-prod",
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "title": "Active Instances",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
        "targets": [{ "expr": "count(up{job=\"vllm\"} == 1)" }],
        "fieldConfig": {
          "defaults": { "thresholds": { "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 6 },
            { "color": "green", "value": 8 }
          ]}}
        }
      },
      {
        "title": "Total Throughput (tok/s)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
        "targets": [{ "expr": "sum(vllm:avg_generation_throughput_toks_per_s)" }]
      },
      {
        "title": "Requests Waiting (queue)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
        "targets": [{ "expr": "sum(vllm:num_requests_waiting)" }],
        "fieldConfig": {
          "defaults": { "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 100 }
          ]}}
        }
      },
      {
        "title": "P95 Latency (s)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
        "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket[5m])) by (le))" }]
      },
      {
        "title": "Error Rate",
        "type": "stat",
        "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
        "targets": [{ "expr": "sum(rate(vllm:num_requests_total{status=~\"5..\"}[5m])) / sum(rate(vllm:num_requests_total[5m]))" }],
        "fieldConfig": {
          "defaults": { "unit": "percentunit", "thresholds": { "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 0.01 },
            { "color": "red", "value": 0.05 }
          ]}}
        }
      },
      {
        "title": "Throughput per Instance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [{ "expr": "vllm:avg_generation_throughput_toks_per_s", "legendFormat": "{{ instance }}" }]
      },
      {
        "title": "Queue Depth per Instance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [{ "expr": "vllm:num_requests_waiting", "legendFormat": "{{ instance }}" }]
      },
      {
        "title": "KV Cache Usage per Instance",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [{ "expr": "vllm:gpu_cache_usage_perc", "legendFormat": "{{ instance }}" }],
        "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
      },
      {
        "title": "Latency Distribution",
        "type": "heatmap",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [{ "expr": "sum(rate(vllm:e2e_request_latency_seconds_bucket[5m])) by (le)" }]
      }
    ]
  }
}
